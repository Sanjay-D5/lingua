EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
EXPO_PUBLIC_POSTHOG_HOST=https://your-posthog-host

# Clerk secret key (Dashboard > API Keys) — used server-side only, by the
# Stream API routes, to verify the Clerk session token sent from the app.
# Never prefix this with EXPO_PUBLIC_.
CLERK_SECRET_KEY=sk_your_clerk_secret_key_here

# Stream (video calling) — server-side only, read by src/app/api/stream/*.
# The client never gets these directly: the token API route hands the public
# API key back in its response. Never prefix STREAM_API_SECRET with EXPO_PUBLIC_.
STREAM_API_KEY=your_stream_api_key_here
STREAM_API_SECRET=your_stream_api_secret_here

# Vision Agent (AI teacher) server — server-side only, read by
# src/app/api/agent/*. Points at the Python vision-agent's `serve` HTTP API
# (see vision-agent/README.md). The shared secret is checked by the Python
# server's can_start_session/can_close_session hooks; it must match
# VISION_AGENT_SHARED_SECRET in vision-agent/.env. Never prefix with EXPO_PUBLIC_.
VISION_AGENT_URL=http://localhost:8000
VISION_AGENT_SHARED_SECRET=your_shared_secret_here

# Needed for a native (non-web) production/standalone build, so the app knows
# where to reach its own API routes. In local dev this is normally resolved
# automatically from the Metro dev server via Constants.expoConfig.hostUri —
# but on some dev-client setups that comes back empty, in which case set this
# explicitly to this machine's LAN IP + Metro's port (e.g. http://192.168.x.x:8081),
# not localhost, since the device/emulator needs to reach it over the network.
# EXPO_PUBLIC_API_BASE_URL=https://your-deployed-app.example.com
