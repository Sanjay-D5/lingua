GEMINI_API_KEY=
STREAM_API_KEY=
STREAM_API_SECRET=

# Shared secret checked on incoming /calls/*/sessions requests from the Expo
# API routes (src/app/api/agent/*). Must match VISION_AGENT_SHARED_SECRET in
# the app's root .env. Leave unset to disable the check (local dev only).
VISION_AGENT_SHARED_SECRET=
